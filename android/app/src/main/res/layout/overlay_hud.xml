<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_drag"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="按住拖移"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/overlay_smaller"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="－"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_larger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="前方淨空"
        android:textColor="@color/fg"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="尚未定位"
        android:textColor="@color/fg"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_road"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="260dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />
</LinearLayout>
