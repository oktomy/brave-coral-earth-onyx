<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="日本全國・2,666 處"
            android:textColor="@color/amber"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="測速導航"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="尚未開始。資料在這支 App 裡。"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/alert_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="還沒開始"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alert_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="尚未定位"
                android:textColor="@color/fg"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="— 公里／時"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/alert_road"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fg"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_amber"
            android:text="開始警示"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/demo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_surface"
            android:text="試跑警示"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="16sp" />

        <Button
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_surface"
            android:text="浮在 Google 地圖上"
            android:textAllCaps="false"
            android:textColor="@color/amber"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="小窗按住可拖到別的位置，＋ － 可放大縮小。位置和大小會記住。"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="導航"
            android:textColor="@color/fg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="輸入目的地後列出路線兩旁約 350 公尺內的測速。轉彎交給 Google 地圖，這支 App 負責響，並可浮在地圖上。"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/dest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card"
            android:hint="目的地，例如 高松站、金刀比羅宮"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/plan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_amber"
            android:text="列出沿途測速"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/maps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_surface"
            android:text="用 Google 地圖導航"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/plan_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/route_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/route_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="警示距離"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/r400"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_surface"
                android:text="400 公尺"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <Button
                android:id="@+id/r800"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/btn_amber"
                android:text="800 公尺"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/r1200"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_surface"
                android:text="1.2 公里"
                android:textAllCaps="false"
                android:textColor="@color/fg"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/ahead"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_amber"
            android:text="只報前方"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="12dp"
            android:text="不是警察官方清單。多數點是公開地圖針尖，大約差一百到兩百公尺。限速是公布值，不是拍照門檻。請看路。關掉警示或劃掉通知就不會再響。"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
